# ==========================================
# AI-Driven Vehicle Rental Management System
# Git Ignore Configuration
# ==========================================

# 1. Node & Frontend Dependencies
node_modules/
*/node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json.bak

# 2. Build Outputs
dist/
frontend/dist/
build/
out/
.vite/
frontend/.vite/

# 3. Python Cache & Virtual Environments
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
*.egg-info/
dist/
wheels/

# 4. Testing & Coverage
.pytest_cache/
*/.pytest_cache/
.coverage
.coverage.*
htmlcov/
*.cover

# 5. Local Database Clusters & Logs
.pgdata/
*.pgdata
*.sqlite3
*.db
logfile
*.log
logs/

# 6. Environment Variables (Protect Credentials)
.env
.env.local
.env.*.local
!.env.example

# 7. IDE & Editor Specific
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# 8. OS System Files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini
